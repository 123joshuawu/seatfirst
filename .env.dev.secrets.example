# Local-development credentials. Copy to `.env.dev.secrets` (gitignored). The values below
# are deliberate non-production dummies; put a real TMDB or Mapbox token only in the local file.

POSTGRES_PASSWORD=dev-only-not-for-prod
POSTGRES_READONLY_PASSWORD=dev-only-readonly-not-for-prod
# First-init passwords for docker/postgres/13-scheduler-roles.sh and
# docker/postgres/14-app-role.sh (the retention_worker / replication /
# seatfirst_app roles migrations 022/023 GRANT to). Dev-only placeholders in
# the same style as the passwords above — not real secrets. The dev stack
# still connects over the shared DATABASE_URL below; nothing logs in as these
# roles, they only need to exist with SOME valid password at init time.
POSTGRES_RETENTION_PASSWORD=dev-only-retention-not-for-prod
POSTGRES_REPLICATION_PASSWORD=dev-only-replication-not-for-prod
POSTGRES_APP_PASSWORD=dev-only-app-not-for-prod
REDIS_PASSWORD=dev-only-not-for-prod
REDIS_READONLY_PASSWORD=dev-only-readonly-not-for-prod
# REDIS_URL must embed the password above (the Valkey ACL now requires auth for `default`,
# matching prod's render-acl.sh pattern) — REDIS_URL wins over REDIS_HOST/PORT/PASSWORD in
# apps/server/src/queue/client.ts, so it carries the credential here rather than in
# `.env.dev.example`.
REDIS_URL=redis://default:dev-only-not-for-prod@valkey:6379
DATABASE_URL=postgres://postgres:dev-only-not-for-prod@postgres:5432/postgres
COOKIE_SECRET=dev-cookie-secret-not-for-prod
NONCE_SECRET=dev-nonce-secret-not-for-prod
MAPBOX_ACCESS_TOKEN=dev-only-mapbox-token-not-for-prod

# Leave blank to keep the TMDB worker disabled. A real token belongs only in `.env.dev.secrets`.
TMDB_API_KEY=
