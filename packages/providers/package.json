{
  "name": "@seatfirst/providers",
  "version": "0.1.0",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "description": "VenueProvider contract + AMC adapter + recorded fixtures (architecture §4, §9)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:fixtures": "vitest run test/fixtures.replay.test.ts test/support/replay.self-test.test.ts",
    "test:update-goldens": "UPDATE_GOLDENS=1 vitest run test/fixtures.replay.test.ts",
    "guard:fixtures": "node scripts/check-fixture-hygiene.mjs",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@seatfirst/core": "workspace:*",
    "cheerio": "^1.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@seatfirst/config": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "geo-tz": "^8.1.8",
    "tsx": "4.19.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
