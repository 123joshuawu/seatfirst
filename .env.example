# Self-hosted Seatfirst environment (docker-compose.yml at the repo root).
# Copy to `.env` (gitignored) and fill in every placeholder — the values below
# are deliberately not usable secrets. There is no Tailscale, AWS, relay, or
# scheduler configuration here; this file covers the simplified public stack
# only (postgres, valkey, migrate, app, web, fetch-worker).

# ---- Postgres (local credentials for the self-hosted database) ----
# Must stay in sync with DATABASE_URL below (user, password, and db name).
POSTGRES_USER=seatfirst
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=seatfirst

# Connection strings used by `app` and `fetch-worker`. The defaults baked into
# docker-compose.yml already point at the Compose services, so you only need to
# set these if you changed the Postgres credentials or run Postgres elsewhere.
# DATABASE_URL=postgres://seatfirst:change-me-local-password@postgres:5432/seatfirst
# REDIS_URL=redis://valkey:6379

# ---- App ports ----
# Host port for the Fastify API, and host port for the static web server.
API_PORT=4000
WEB_PORT=8080

# Browser CORS allowlist — comma-separated exact origins, no trailing slash, no
# wildcard. Must include the origin you serve `web` from, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=change-me-web-origin

# Cookie / nonce secrets — generate two fresh random strings, e.g.:
#   openssl rand -base64 32
COOKIE_SECRET=change-me-cookie-secret
NONCE_SECRET=change-me-nonce-secret

# ---- Mapbox (place search / "Where" resolution) ----
# Seatfirst resolves free-text place input ("theatres near Sunnyvale") through
# the Mapbox Geocoding API on the temporary (non-storage) tier. You need your
# own token:
#   1. Create a free account at https://account.mapbox.com/auth/signup/
#   2. Open https://console.mapbox.com/ and copy the Default public token
#      (or create a new token with the `geocoding:read` scope).
#   3. Paste it below. Billing is per request (~$0.75 / 1,000 at low volume);
#      results are never stored, per the temporary-tier terms.
MAPBOX_ACCESS_TOKEN=change-me-mapbox-token

# Optional: log verbosity (`debug`, `info`, `warn`, `error`). Defaults to `info`.
# LOG_LEVEL=info

# ---- Fetch-worker egress identity (ADR 0099 residential mode) ----
# The fetch-worker verifies at startup that its outbound public IP exactly
# matches EGRESS_IDENTITY_LABEL (fail-closed). For self-hosted residential
# egress, discover your current public IP with:
#   curl https://checkip.amazonaws.com
# and paste the exact result below (no placeholder will work — the worker
# compares the live HTTPS response textually and refuses to start on mismatch).
# Re-check after ISP renumbering or NAT changes. Keep EGRESS_MODE=residential
# for plain Docker with no Tailscale (the container's default route via eth0).
EGRESS_MODE=residential
EGRESS_IDENTITY_LABEL=replace-with-your-public-ip
